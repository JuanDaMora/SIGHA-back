# ============================================
# SIGHA Backend - Ingeniería en Inteligencia Artificial
# ============================================

# Imagen Docker
APP_IMAGE=sigha-backend:latest
APP_CONTAINER_NAME=sigha-ia-backend-preprod

# Puertos
APP_PORT=8083
APP_INTERNAL_PORT=8080

# Base de datos
SPRING_DATASOURCE_URL=jdbc:postgresql://sigha-db-preprod:5432/sigha
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=clave123

# Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=ing_inteligencia_artificial

# Seguridad
APP_SECRET_KEY=your-secret-key-here-change-in-production

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FAKE=test@example.com

# URLs
SIGHA_URL_ACCESS=http://localhost:5175

